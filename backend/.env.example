APP_ENV=development
DATABASE_URL=sqlite:///./techkart.db
CORS_ORIGINS=["http://localhost:5173"]

# Generate a unique value for every shared/staging/production environment.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=techkart-api
JWT_AUDIENCE=techkart-web
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_REQUEST_BODY_BYTES=1000000
MAX_AUDIO_UPLOAD_BYTES=10485760
MAX_IMAGE_UPLOAD_BYTES=8388608

# OpenAI is the only AI provider. Keep the key out of source control and rotate it if exposed.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
